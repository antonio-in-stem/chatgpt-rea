{
  "name": "@rea/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./styles.css": "./styles/original.css",
    "./animations": "./animations/index.js",
    "./SvgLottie": "./src/SvgLottie.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:example": "esbuild examples/main.js --bundle --format=esm --outfile=dist/example.js",
    "dev": "node scripts/serve.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "description": "Source-traced reusable frontend components; extraction in progress",
  "dependencies": {
    "esbuild": "0.28.0",
    "framer-motion": "12.43.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "files": [
    "src/",
    "styles/",
    "animations/",
    "provenance.json",
    "*-manifest.json",
    "*-contract.json",
    "CONSUMING.md",
    "CONVERSATION-INTEGRATION.md"
  ]
}
